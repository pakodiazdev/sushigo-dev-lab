# ---------------------------------------------------------------------------
# tools.env — Tool versions and port configuration for sushigo-dev-lab
#
# Used by:  scripts/install-prereqs.sh
#           scripts/setup.sh
#           scripts/create-workspace.sh
#           make install
#
# Override per-command:
#   make install PHP=8.2 NODE=20
#   ./scripts/install-prereqs.sh --php=8.2 --node=20
#   API_PORT_A=9001 ./scripts/setup.sh --workspaces=1
# ---------------------------------------------------------------------------

PHP_VERSION="8.3"
NODE_VERSION="22"

# ── Per-slot port configuration ─────────────────────────────────────────────
# Change any entry if it conflicts with a service already running on your machine.
API_PORT_A=8001
API_PORT_B=8002
API_PORT_C=8003
API_PORT_D=8004
API_PORT_E=8005
API_PORT_F=8006
API_PORT_G=8007
API_PORT_H=8008

VITE_PORT_A=5171
VITE_PORT_B=5172
VITE_PORT_C=5173
VITE_PORT_D=5174
VITE_PORT_E=5175
VITE_PORT_F=5176
VITE_PORT_G=5177
VITE_PORT_H=5178
