# ---------------------------------------------------------------------------
# tools.env.example — Template for local tool versions and port configuration
#
# Setup: copy this file to tools.env and adjust values to fit your machine.
#   cp tools.env.example tools.env
#
# tools.env is gitignored — each developer keeps their own local copy.
#
# Used by:  scripts/install-prereqs.sh
#           scripts/setup.sh
#           scripts/create-workspace.sh
#           make install
# ---------------------------------------------------------------------------

PHP_VERSION="8.3"
NODE_VERSION="22"

# ── Per-slot port configuration ─────────────────────────────────────────────
# Change any entry if it conflicts with a service already running on your machine.
API_PORT_A=8001
API_PORT_B=8002
API_PORT_C=8003
API_PORT_D=8004
API_PORT_E=8005
API_PORT_F=8006
API_PORT_G=8007
API_PORT_H=8008

VITE_PORT_A=5171
VITE_PORT_B=5172
VITE_PORT_C=5173
VITE_PORT_D=5174
VITE_PORT_E=5175
VITE_PORT_F=5176
VITE_PORT_G=5177
VITE_PORT_H=5178

# ── E2E port configuration (per slot, for make e2e WORKSPACE=sushigo-x) ────────
E2E_API_PORT_A=8901
E2E_API_PORT_B=8902
E2E_API_PORT_C=8903
E2E_API_PORT_D=8904
E2E_API_PORT_E=8905
E2E_API_PORT_F=8906
E2E_API_PORT_G=8907
E2E_API_PORT_H=8908

E2E_VITE_PORT_A=5181
E2E_VITE_PORT_B=5182
E2E_VITE_PORT_C=5183
E2E_VITE_PORT_D=5184
E2E_VITE_PORT_E=5185
E2E_VITE_PORT_F=5186
E2E_VITE_PORT_G=5187
E2E_VITE_PORT_H=5188

# ── Agent labels (shown in browser tab title) ────────────────────────────────
AGENT_LABEL_A=[A]
AGENT_LABEL_B=[B]
AGENT_LABEL_C=[C]
AGENT_LABEL_D=[D]
AGENT_LABEL_E=[E]
AGENT_LABEL_F=[F]
AGENT_LABEL_G=[G]
AGENT_LABEL_H=[H]
