# ---------------------------------------------------------------------------
# tools.env — Required tool versions for sushigo-dev-lab
#
# Used by:  scripts/install-prereqs.sh
#           make install
#
# Override per-command:
#   make install PHP=8.2 NODE=20
#   ./scripts/install-prereqs.sh --php=8.2 --node=20
# ---------------------------------------------------------------------------

PHP_VERSION="8.3"
NODE_VERSION="22"
