# ---------------------------------------------------------------------------
# .env.example — Template for docker-compose.yml overrides
#
# Setup: copy this file to .env and adjust values to fit your machine.
#   cp .env.example .env
#
# .env is gitignored — every value here has a working default in
# docker-compose.yml, so an empty/missing .env is fine too. This file only
# documents what CAN be overridden and why you'd want to.
#
# For per-workspace / per-agent settings (ports, tool versions, tokens),
# see tools.env.example instead.
# ---------------------------------------------------------------------------

# ── PostgreSQL (shared across every workspace + pgAdmin) ────────────────────
# Changing these after the pgdata volume already exists does NOT rename the
# existing superuser — it only changes what new services expect. Rotate by
# also running `ALTER ROLE` yourself, or wipe the volume (`make down` +
# `docker compose down -v`) and let setup.sh recreate it from scratch.
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_HOST_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST_PORT=6379

# ── Mailpit ───────────────────────────────────────────────────────────────
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025

# ── pgAdmin (opt-in — `make pgadmin` / `make pgadmin-stop`, see README) ─────
# Browses the shared PostgreSQL instance above. No login is required — it
# runs in desktop mode, bound to the loopback interface only.
PGADMIN_HOST_PORT=5050
# Bootstraps pgAdmin's own internal account record — not a database
# credential, and never used for external login since the login page is
# disabled. Safe to leave as-is.
PGADMIN_DEFAULT_EMAIL=dev@sushigo.local
PGADMIN_DEFAULT_PASSWORD=admin

# ── SonarCloud ───────────────────────────────────────────────────────────────
# Propagated into every workspace's .env as SONAR_TOKEN_API / SONAR_TOKEN_WEBAPP
# by setup.sh and create-workspace.sh. Generate at:
# https://sonarcloud.io/account/security
SONAR_TOKEN=
